#!/bin/sh
#
# Pre-commit hook: Runs the same checks as CI (fmt, clippy, wasm, test).
# Catches issues before they reach GitHub Actions.
#
# Install: ./scripts/setup-hooks.sh
#
# Toolchain: the repo pins `channel = "stable"` via rust-toolchain.toml,
# so `cargo` below uses the same compiler CI uses. Run `rustup update stable`
# periodically so your local toolchain picks up new lints before CI does.

set -e

echo "=== Pre-commit checks ==="

# 1. Formatting
echo "[1/4] Checking formatting..."
if ! cargo fmt --all -- --check 2>&1; then
    echo ""
    echo "ERROR: Formatting check failed!"
    echo "Run 'cargo fmt --all' to fix."
    echo ""
    exit 1
fi
echo "  OK"

# 2. Clippy (warnings as errors, matching CI)
echo "[2/4] Running clippy..."
if ! cargo clippy --workspace --all-targets -- -D warnings 2>&1; then
    echo ""
    echo "ERROR: Clippy found warnings/errors!"
    echo "Fix the issues above before committing."
    echo ""
    exit 1
fi
echo "  OK"

# 3. WASM check (ui-zoo-web is excluded from the workspace, so it's not
# covered by the workspace-wide clippy/test runs above).
echo "[3/4] Checking WASM build (ui-zoo-web)..."
if ! (cd examples/ui-zoo-web && cargo check --target wasm32-unknown-unknown) 2>&1; then
    echo ""
    echo "ERROR: WASM build check failed!"
    echo "ui-zoo-web must compile for wasm32-unknown-unknown."
    echo ""
    exit 1
fi
echo "  OK"

# 4. Tests
echo "[4/4] Running tests..."
if ! cargo test --workspace 2>&1; then
    echo ""
    echo "ERROR: Tests failed!"
    echo "Fix failing tests before committing."
    echo ""
    exit 1
fi
echo "  OK"

echo ""
echo "All pre-commit checks passed."
exit 0
